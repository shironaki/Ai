// Настройки проекта для инструмента публикации (@tgcloud/cli).
//
// static.source — папка страницы мини-приложения «Комната». Сборки у страницы нет:
// файлы уходят на платформу как лежат. Папку нельзя называть dist, build или out.
// Других ключей здесь нет намеренно: их проверяет сама платформа, и незнакомый
// ей ключ сорвал бы отправку страницы. Как страница публикуется — docs/PHONE.md.
{
  "static": { "source": "miniapp" }
}
