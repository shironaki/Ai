{
  "name": "Telegram Bot - Python 3.11",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "secrets": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from @BotFather",
      "documentationUrl": "https://core.telegram.org/bots/tutorial"
    },
    "GROQ_API_KEY": {
      "description": "Optional Groq API key for AI replies",
      "documentationUrl": "https://console.groq.com/keys"
    }
  },
  "postStartCommand": "sh ./codespace_boot.sh"
}
